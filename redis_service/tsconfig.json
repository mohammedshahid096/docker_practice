{
  "compilerOptions": {
    /* ─── Language & Environment ─────────────────────────────── */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* ─── Output ─────────────────────────────────────────────── */
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    /* ─── Strict Type Checking (the non-negotiables) ─────────── */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,

    /* ─── Code Quality ───────────────────────────────────────── */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,

    /* ─── Interop & Compatibility ────────────────────────────── */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* ─── Performance ────────────────────────────────────────── */
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "skipLibCheck": true

    /* ─── Decorators (enable only if using NestJS / TypeORM) ─── */
    // "experimentalDecorators": true,
    // "emitDecoratorMetadata": true,

    /* ─── Path Aliases (adjust to your project structure) ───── */
    // "baseUrl": "."
    // "paths": {
    //   "@/*": ["src/*"],
    //   "@config/*": ["src/config/*"],
    //   "@modules/*": ["src/modules/*"],
    //   "@shared/*": ["src/shared/*"],
    //   "@utils/*": ["src/utils/*"]
    // }
  },

  "include": ["src/**/*.ts", "app.ts", "server.ts", ".env"],

  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
